{
  "name": "out-of-character",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "bun run build && vite preview",
    "test": "bun test",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check:engine": "bun scripts/engine-boundary-check.ts && tsc -p tsconfig.engine.json --noEmit && bun scripts/engine-copy-check.ts",
    "check:probes": "bun scripts/probe-build-check.ts",
    "check": "bun run typecheck && bun run check:engine && bun run check:probes && bun test && bun run build && bun scripts/simulator-bundle-check.ts && wrangler deploy --dry-run",
    "deploy": "bun run build && wrangler deploy --keep-vars",
    "deploy:preview": "bun run build && wrangler preview --ignore-base-config",
    "cf-typegen": "wrangler types && react-router typegen",
    "eval:jev": "bun ai/evals/run.ts",
    "eval:simulator": "bun --env-file=.dev.vars ai/simulator/run.ts",
    "eval:director": "bun --env-file=.dev.vars ai/simulator/director-replay.ts"
  },
  "dependencies": {
    "@ai-sdk/azure": "4.0.82",
    "@ai-sdk/react": "4.0.121",
    "@ai-sdk/typesafe-ai": "3.0.2",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/mermaid": "^1.0.3",
    "@xstate/react": "^6.1.0",
    "ai": "7.0.118",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.26.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router": "7.14.2",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.5.0",
    "xstate": "^5.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.0",
    "@react-router/dev": "7.14.2",
    "@tailwindcss/vite": "4.2.4",
    "@types/bun": "1.3.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "1.62.1",
    "tailwindcss": "4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "wrangler": "4.143.0"
  }
}
