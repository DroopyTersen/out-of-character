{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "out-of-character",
  "account_id": "bfdf9c3d5020465d9dd2fa73937b29a6",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "outofcharacter.droopy.dev", "custom_domain": true }
  ],
  "compatibility_date": "2026-04-28",
  "main": "./app/workers/app.ts",
  "assets": { "binding": "ASSETS", "run_worker_first": ["/simulator/briefings/*"] },
  "vars": { "PAID_SERVICES_ENABLED": "true", "SIMULATOR_ENABLED": "true" },
  "durable_objects": { "bindings": [{ "name": "SIMULATOR_SESSIONS", "class_name": "SimulatorSession" }] },
  "d1_databases": [{ "binding": "SIMULATOR_ARCHIVE", "database_name": "out-of-character-simulator", "database_id": "e91a81f6-2058-4223-b10a-52f00dc2219f" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "migrations": [{ "tag": "simulator-v1", "new_sqlite_classes": ["SimulatorSession"] }],
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    { "name": "RATE_SIMULATOR", "namespace_id": "26092501", "simple": { "limit": 3, "period": 60 } },
    { "name": "RATE_JUDGE", "namespace_id": "26091801", "simple": { "limit": 180, "period": 60 } },
    { "name": "RATE_SCENE", "namespace_id": "26091802", "simple": { "limit": 20, "period": 60 } },
    { "name": "RATE_SPEECH", "namespace_id": "26091803", "simple": { "limit": 12, "period": 60 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "previews": {
    "observability": { "enabled": true, "head_sampling_rate": 1 },
    "vars": { "PAID_SERVICES_ENABLED": "true", "SIMULATOR_ENABLED": "true" },
    "durable_objects": { "bindings": [{ "name": "SIMULATOR_SESSIONS", "class_name": "SimulatorSession" }] },
    "d1_databases": [{ "binding": "SIMULATOR_ARCHIVE", "database_name": "out-of-character-interview-preview", "database_id": "124396fb-4ce9-43d4-92f2-64f2c70c5c26" }],
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    "ai": { "binding": "AI", "remote": true },
    "ratelimits": [
      { "name": "RATE_SIMULATOR", "namespace_id": "26092701", "simple": { "limit": 3, "period": 60 } },
      { "name": "RATE_JUDGE", "namespace_id": "26092702", "simple": { "limit": 180, "period": 60 } },
      { "name": "RATE_SCENE", "namespace_id": "26092703", "simple": { "limit": 20, "period": 60 } },
      { "name": "RATE_SPEECH", "namespace_id": "26092704", "simple": { "limit": 12, "period": 60 } }
    ]
  }
}
